# ---------------------------------------------------------------------------
# SurveyLink — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env. Secrets live in a secret manager in production.
# ---------------------------------------------------------------------------

# --- Database (Postgres + PostGIS) ---
# App connection (through PgBouncer / RDS Proxy in production).
DATABASE_URL="postgresql://surveylink:surveylink@localhost:5432/surveylink?schema=public"
# Direct connection used by Prisma Migrate (bypasses the connection pooler).
DIRECT_DATABASE_URL="postgresql://surveylink:surveylink@localhost:5432/surveylink?schema=public"

# --- API ---
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# --- DEV ONLY: bypass Auth0/Twilio with a fixed test account. ---
# Never enable in production (it is force-disabled when NODE_ENV=production).
# When true, sign in with dev@surveylink.local / devpass123 (role: both + admin).
AUTH_DEV_MODE=false
# Mirror of the flag for the web app (shows a dev sign-in hint).
NEXT_PUBLIC_AUTH_DEV_MODE=false

# --- Error tracking ---
# Leave blank in local dev to disable Sentry.
SENTRY_DSN=

# --- Auth (Auth0) ---
# Tenant domain, e.g. dev-abc123.us.auth0.com (no protocol).
AUTH0_DOMAIN=
# API identifier / audience of the Auth0 API that represents this backend.
AUTH0_AUDIENCE=
# Application used for the login (Resource Owner Password) grant. This app must
# have the "password" grant enabled and a default audience configured.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Database connection name that stores email/password users.
AUTH0_DB_CONNECTION=Username-Password-Authentication
# Machine-to-machine application authorized for the Auth0 Management API
# (create users, send verification emails, read user status).
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Namespaced custom claim that carries platform roles (e.g. "admin") in the
# access token. Populate it with an Auth0 Action/Rule.
AUTH0_ROLES_CLAIM=https://surveylink.app/roles

# --- Phone OTP (Twilio Verify) + transactional SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Sender for outbound notification SMS. Prefer a Messaging Service SID; a single
# from-number works too. If neither is set, SMS degrades to a log-only stub.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=

# --- Email (SendGrid) ---
# If unset, email degrades to a log-only stub (local dev / CI).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=SurveyLink

# --- Object storage (S3-compatible; wired up when portfolio uploads land) ---
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Maps (frontend) ---
# NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
