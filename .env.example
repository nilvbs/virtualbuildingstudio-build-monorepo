# ---------------------------------------------------------------------------
# SurveyLink — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env. Secrets live in a secret manager in production.
# ---------------------------------------------------------------------------

# --- Database ---
# Local default: Windows/macOS Postgres via pgAdmin (this repo uses port 5433).
# Create role+db "surveylink"/"surveylink" — see scripts/setup-local-postgres.sql
# PostGIS must be installed (Stack Builder on Windows). Docker is optional: `pnpm db:up` → port 5432.
DATABASE_URL="postgresql://surveylink:surveylink@localhost:5433/surveylink?schema=public"
# Direct connection used by Prisma Migrate (bypasses the connection pooler).
DIRECT_DATABASE_URL="postgresql://surveylink:surveylink@localhost:5433/surveylink?schema=public"

# --- API ---
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# Comma-separated web origins allowed by CORS in deployed envs. Falls back to
# WEB_APP_URL; if both are empty (local dev) the request origin is reflected.
# e.g. https://app.bld.app,https://admin.bld.app
CORS_ORIGINS=
# Rate limiting (per instance): window in ms + max requests per IP per window.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Redis (ElastiCache/Upstash) — distributed rate limiting + caching at scale.
REDIS_URL=

# --- DEV ONLY: bypass Auth0/SMS providers with a fixed test account. ---
# Never enable in production (it is force-disabled when NODE_ENV=production).
# When true, sign in with dev@surveylink.local / devpass123 (role: both + admin).
# Phone OTP is always sent via Twilio (no dummy 000000 codes).
AUTH_DEV_MODE=false
# Mirror of the flag for the web app (shows a dev sign-in hint).
NEXT_PUBLIC_AUTH_DEV_MODE=false

# --- Error tracking ---
# Leave blank in local dev to disable Sentry.
SENTRY_DSN=

# --- Auth (Auth0 + Google) ---
# Marketplace sign-in/sign-up is Google OAuth only (Auth0 social connection).
# Tenant domain, e.g. dev-abc123.us.auth0.com (no protocol).
AUTH0_DOMAIN=
# API identifier / audience of YOUR Auth0 API (Applications → APIs → create one).
# Do NOT use the Management API (…/api/v2/) — that forces the Authorize consent
# screen on every Google login. Create e.g. https://api.surveylink.local and set
# "Allow Skipping User Consent". Localhost callbacks may still show consent once.
AUTH0_AUDIENCE=
# Application used for the Authorization Code (Google) grant.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Database connection name (still used for staff / legacy password paths if any).
AUTH0_DB_CONNECTION=Username-Password-Authentication
# Machine-to-machine application authorized for the Auth0 Management API
# (create users, send verification emails, read user status).
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Namespaced custom claim that carries platform roles (e.g. "admin") in the
# access token. Populate it with an Auth0 Action/Rule.
AUTH0_ROLES_CLAIM=https://surveylink.app/roles
# --- Google sign-in (Auth0 social connection) ---
# 1. In Auth0 → Authentication → Social, enable the Google connection and add
#    your Google Cloud OAuth 2.0 client ID + secret (Google Cloud Console →
#    APIs & Services → Credentials).
# 2. In the Auth0 Application, add these to "Allowed Callback URLs":
#      http://localhost:3000/auth/callback
#      surveylink://auth-callback
#    For Expo Go, also add the printed mobile redirect (Metro logs:
#    `[auth] Google redirectUri → exp://…`). Wildcards like
#    `exp://127.0.0.1:*/*` / `exp://192.168.*:*/*` may work depending on tenant.
# 3. Ensure the Application has the "Authorization Code" grant enabled.
# Auth0 connection name for Google (default is fine unless you renamed it).
AUTH0_GOOGLE_CONNECTION=google-oauth2

# Public base URL of the web app; default OAuth redirect_uri for web clients.
WEB_APP_URL=http://localhost:3000

# --- AWS (S3 media only) ---
# Examples: us-east-2, ap-south-1, etc.
AWS_REGION=us-east-2
# IAM user access keys (not an instance role). Required for local S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Twilio (SMS + email via SendGrid) ---
# Console: https://console.twilio.com — Account SID + Auth Token.
# TWILIO_FROM_NUMBER must be an E.164 Twilio number (or Messaging Service sender).
# Trial accounts can only SMS verified destination numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email OTP + match notifications use Twilio SendGrid (Mail Send API).
# Create an API key in SendGrid (Mail Send permission). Key starts with SG.
# Verify a sender identity or authenticate your domain in SendGrid first.
SENDGRID_API_KEY=
TWILIO_EMAIL_FROM=
TWILIO_EMAIL_FROM_NAME=BLD
# Aliases also accepted: TWILIO_SENDGRID_API_KEY, SENDGRID_FROM_EMAIL, SENDGRID_FROM_NAME
# --- Object storage (S3) — all media uploads ---
# Default bucket is bld-build. Objects are segregated by folder:
#   avatar/  portfolio/  document/  logo/  cover/  certificate/
S3_BUCKET=bld-build
# Defaults to AWS_REGION when unset:
# S3_REGION=
# Optional explicit credentials (otherwise default AWS chain / instance role):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional CDN / custom domain prefix (no trailing slash):
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Set only if bucket ACLs are enabled:
# S3_OBJECT_ACL=public-read

# --- Maps (frontend) ---
# Copy into apps/web/.env.local (Next inlines NEXT_PUBLIC_* at start)
# Also set NEXT_PUBLIC_MAPBOX_TOKEN on GitHub Environment "staging" so Deploy Web
# can bake Mapbox into the Cloudflare Worker (otherwise the landing map falls back to SVG).
# NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Super admin bootstrap ---
# On API start, ensures this account exists as staffLevel=super_admin.
# Never commit real passwords. Set these in your local `.env` only.
SUPER_ADMIN_EMAIL=tracker@virtualBuildingstudio.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=+10000000001
SUPER_ADMIN_NAME=Super Admin

# --- Web ---
# Local:
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Staging (Cloudflare web → EC2 API via Nginx /api prefix):
# NEXT_PUBLIC_API_URL="https://staging.bld.online/api"
# --- Staging (one host) ---
# Web + API: https://staging.bld.online  and  https://staging.bld.online/api
# NEXT_PUBLIC_API_URL="https://staging.bld.online/api"
# WEB_APP_URL=https://staging.bld.online
# CORS_ORIGINS=https://staging.bld.online

