# Web app (Next.js on Cloudflare Workers via OpenNext)
#
# Local: copy to apps/web/.env.local
# Staging build/deploy: copy to apps/web/.env.production (or export vars before deploy)
#
# NEXT_PUBLIC_* are inlined at build time.

# --- Staging (Cloudflare → EC2 API) ---
NEXT_PUBLIC_API_URL=https://staging.bld.online/api
NEXT_PUBLIC_AUTH_DEV_MODE=false

# --- Local ---
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_AUTH_DEV_MODE=true

# Mapbox public token for coverage / project location maps
# Also set as GitHub Environment variable `NEXT_PUBLIC_MAPBOX_TOKEN` (staging)
# so Deploy Web inlines it into the Cloudflare Worker build.
# NEXT_PUBLIC_MAPBOX_TOKEN=
