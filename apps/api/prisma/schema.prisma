// SurveyLink — Phase 1 data model (11 tables, four groups).
//
//   Person     users, user_roles
//   Profiles   account_profiles, surveyor_profiles, admin_profiles
//   Jobs       projects, matches
//   Plumbing   contact_otps, notifications
//
// Read DATA_MODEL.md in this folder before adding tables. Wizard fields go in
// JSON (`projects.details`, `surveyor_profiles.details`), not new tables.
//
// SQL in ./migrations is authoritative (PostGIS GEOGRAPHY, GIST/GIN, CHECKs).
// This file mirrors it for `@prisma/client`. Geography is Unsupported(...);
// geo I/O is raw SQL. Ship changes as new migrations (`prisma migrate deploy`).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, postgis]
}

/** Login identity. Hats live in UserRole; do not use roleHint for access. */
model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** Legal / display name for self + admin. Marketplace peers see `username` instead. */
  fullName       String   @map("full_name")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  /** Unique public handle, generated from first + last name at signup. */
  username       String   @unique @map("username")
  email          String   @unique
  phone          String   @unique
  emailVerified  Boolean  @default(false) @map("email_verified")
  phoneVerified  Boolean  @default(false) @map("phone_verified")
  /** Object-storage key for optional profile photo. */
  avatarKey      String?  @map("avatar_key")
  /**
   * Post-signup gate for marketplace users (client + surveyor):
   * select_account_type → accept_terms → verify_contact → complete_profile → portfolio (surveyor) → done
   */
  onboardingStep String   @default("select_account_type") @map("onboarding_step")
  /** Company vs individual — chosen on the first onboarding screen; drives later fields. */
  accountType    String   @default("individual") @map("account_type")
  /** Set when the user confirms individual vs company on onboarding (required gate). */
  accountTypeSelectedAt DateTime? @map("account_type_selected_at") @db.Timestamptz(6)
  /** Set once the user accepts the Terms & Conditions (required before onboarding). */
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  /** Set once the user accepts the NDA (required before onboarding). */
  ndaAcceptedAt   DateTime? @map("nda_accepted_at") @db.Timestamptz(6)
  /** @deprecated Prefer UserRole memberships; kept for back-compat / display. */
  roleHint       String   @default("client") @map("role_hint")
  status         String   @default("active")
  authProvider   String?  @map("auth_provider")
  authSubject    String?  @unique @map("auth_subject")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles           UserRole[]
  surveyorProfile SurveyorProfile?
  adminProfile    AdminProfile?
  accountProfile  AccountProfile?
  contactOtps     ContactOtp[]
  projects        Project[]
  matchesMade     Match[]          @relation("MatchedBy")
  notifications   Notification[]
  feedbackGiven   Feedback[]       @relation("FeedbackFrom")
  feedbackReceived Feedback[]      @relation("FeedbackTo")
  helpTickets     HelpTicket[]     @relation("HelpTicketOwner")
  helpTicketsAssigned HelpTicket[] @relation("HelpTicketAssignee")
  helpTicketMessages HelpTicketMessage[]
  activityLogs    ActivityLog[]

  @@index([authSubject], map: "idx_users_auth_subject")
  @@map("users")
}

/** Short-lived contact OTP codes (email, work_email, phone) delivered via SES/SNS. */
model ContactOtp {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  channel     String
  destination String
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel], map: "idx_contact_otps_user_channel")
  @@index([expiresAt], map: "idx_contact_otps_expires")
  @@map("contact_otps")
}

/** One row per hat: client | surveyor | admin. */
model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role], map: "uq_user_roles_user_role")
  @@index([userId], map: "idx_user_roles_user_id")
  @@index([role], map: "idx_user_roles_role")
  @@map("user_roles")
}

/**
 * Shared address + company fields for any hat (client or surveyor).
 * Individuals fill an address; companies add name, work email, registration, website.
 */
model AccountProfile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  companyName        String?  @map("company_name")
  addressLine1       String?  @map("address_line1")
  addressLine2       String?  @map("address_line2")
  city               String?
  state              String?
  postalCode         String?  @map("postal_code")
  country            String?
  workEmail          String?  @map("work_email")
  workEmailVerified  Boolean  @default(false) @map("work_email_verified")
  registrationNumber String?  @map("registration_number")
  website            String?
  /** Average star rating from surveyors (1–5). Null until reviews exist. */
  ratingAvg          Float?   @map("rating_avg")
  ratingCount        Int      @default(0) @map("rating_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_profiles")
}

model AdminProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  title            String?
  /** super_admin | admin */
  staffLevel       String   @default("admin") @map("staff_level")
  /** viewer | matcher | full | custom */
  permissionPreset String   @default("matcher") @map("permission_preset")
  /** JSON array of StaffPermission strings when preset is custom (or overrides). */
  permissions      Json     @default("[]")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model SurveyorProfile {
  id           String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                                 @unique @map("user_id") @db.Uuid
  bio          String?
  services     Json                                   @default("[]")
  equipment    Json                                   @default("[]")
  baseLocation Unsupported("geography(Point, 4326)")? @map("base_location")
  baseCity     String?                                @map("base_city")
  radiusKm     Int                                    @default(25) @map("radius_km")
  dayRateCents BigInt?                                @map("day_rate_cents")
  /** Average star rating (1–5). Null until reviews exist. */
  ratingAvg    Float?                                 @map("rating_avg")
  ratingCount  Int                                    @default(0) @map("rating_count")
  /** Platform-verified badge (identity / docs). Contact OTP is separate. */
  bldVerified  Boolean                                @default(false) @map("bld_verified")
  portfolio    Json                                   @default("[]")
  /** Core + Identity portfolio payload (services coverage, pricing, identity, etc.). */
  details      Json                                   @default("{}")
  isMatchable  Boolean                                @default(true) @map("is_matchable")
  createdAt    DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  matches Match[]

  @@map("surveyor_profiles")
}

model Project {
  id           String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String                                 @map("client_id") @db.Uuid
  title        String
  services     Json                                   @default("[]")
  location     Unsupported("geography(Point, 4326)")?
  locationText String?                                @map("location_text")
  buildingType String?                                @map("building_type")
  buildingAge  String?                                @map("building_age")
  floors       Int?
  areaSqft     Int?                                   @map("area_sqft")
  neededWithin String?                                @map("needed_within")
  notes        String?
  /** Extended client brief from the posting wizard (JSON). */
  details      Json                                   @default("{}")
  status       String                                 @default("submitted")
  createdAt    DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client  User    @relation(fields: [clientId], references: [id])
  matches Match[]
  feedbacks Feedback[]
  helpTickets HelpTicket[]
  activityLogs ActivityLog[]

  @@index([status])
  @@map("projects")
}

model Match {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  surveyorId String   @map("surveyor_id") @db.Uuid
  matchedBy  String   @map("matched_by") @db.Uuid
  status     String   @default("proposed")
  adminNotes String?  @map("admin_notes")
  /** Wall-clock instant when the surveyor's working-hours response window ends. */
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  /** admin = staff match; auto = Uber-style fan-out after project post. */
  offerSource String  @default("admin") @map("offer_source")
  /** Milestone timestamps for date-wise timelines. */
  proposedAt   DateTime? @map("proposed_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  declinedAt   DateTime? @map("declined_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project   Project         @relation(fields: [projectId], references: [id])
  surveyor  SurveyorProfile @relation(fields: [surveyorId], references: [id])
  matcher   User            @relation("MatchedBy", fields: [matchedBy], references: [id])
  feedbacks Feedback[]
  activityLogs ActivityLog[]

  @@index([projectId])
  @@index([surveyorId])
  @@map("matches")
}

/**
 * Post-job rating from client → surveyor or surveyor → client.
 * One feedback per match per reviewer.
 */
model Feedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId    String   @map("match_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  /** client | surveyor — role of the person submitting. */
  fromRole   String   @map("from_role")
  /** Overall stars 1–5. */
  rating     Int
  comment    String
  /** Optional aspect scores: communication, quality, professionalism, timeliness. */
  aspects    Json     @default("{}")
  recommend  Boolean?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromUser User   @relation("FeedbackFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User   @relation("FeedbackTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([matchId, fromUserId], map: "uq_feedbacks_match_from_user")
  @@index([projectId], map: "idx_feedbacks_project_id")
  @@index([toUserId], map: "idx_feedbacks_to_user_id")
  @@index([fromUserId], map: "idx_feedbacks_from_user_id")
  @@index([createdAt], map: "idx_feedbacks_created_at")
  @@map("feedbacks")
}

/**
 * Help desk ticket from a client or surveyor.
 * Conversation lives in HelpTicketMessage.
 */
model HelpTicket {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** Human-readable id, e.g. HD-20260909-A1B2. */
  ticketNumber     String    @unique @map("ticket_number")
  userId           String    @map("user_id") @db.Uuid
  /** client | surveyor — workspace the reporter opened from. */
  workspace        String
  /** account | billing | project | matching | technical | blocker | other */
  category         String
  /** low | normal | high | urgent */
  priority         String    @default("normal")
  subject          String
  /** open | in_progress | waiting | resolved | closed */
  status           String    @default("open")
  projectId        String?   @map("project_id") @db.Uuid
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  /** First staff reply timestamp. */
  firstResponseAt  DateTime? @map("first_response_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                @relation("HelpTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignee   User?               @relation("HelpTicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages   HelpTicketMessage[]
  activityLogs ActivityLog[]

  @@index([userId], map: "idx_help_tickets_user_id")
  @@index([status], map: "idx_help_tickets_status")
  @@index([createdAt], map: "idx_help_tickets_created_at")
  @@map("help_tickets")
}

model HelpTicketMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  isStaff      Boolean  @default(false) @map("is_staff")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], map: "idx_help_ticket_messages_ticket_id")
  @@map("help_ticket_messages")
}

/**
 * Append-only activity timeline for date-wise ops visibility.
 * Examples: project submitted, surveyor assigned, match accepted, ticket replied.
 */
model ActivityLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** project | match | help_ticket | feedback */
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id") @db.Uuid
  projectId    String?  @map("project_id") @db.Uuid
  matchId      String?  @map("match_id") @db.Uuid
  helpTicketId String?  @map("help_ticket_id") @db.Uuid
  /** Machine action key, e.g. project.submitted, match.accepted, ticket.status_changed */
  action       String
  summary      String
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  match      Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)
  helpTicket HelpTicket? @relation(fields: [helpTicketId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt], map: "idx_activity_logs_entity")
  @@index([projectId, occurredAt], map: "idx_activity_logs_project_id")
  @@index([helpTicketId, occurredAt], map: "idx_activity_logs_help_ticket_id")
  @@index([occurredAt], map: "idx_activity_logs_occurred_at")
  @@map("activity_logs")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String?
  /** In-app deep link path (e.g. /client/projects/:id). Absolute URLs also allowed. */
  linkUrl   String?   @map("link_url")
  channel   String    @default("in_app")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}
