# BLD staging API — start after reboot
# On EC2 (after files are in ~/BLD/stage):
#   sudo cp bld-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bld-api.service
[Unit]
Description=BLD staging API (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/BLD/stage
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
