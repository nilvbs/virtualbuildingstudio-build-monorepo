# ---------------------------------------------------------------------------
# Copy this file NEXT TO docker-compose.api.staging.yml on the EC2 host
# and rename it to `.env` (same folder). Do not put secrets in the image.
#
#   /opt/bld/
#     docker-compose.api.staging.yml
#     .env                    ← this file (chmod 600)
#
#   cd /opt/bld && docker compose -f docker-compose.api.staging.yml up -d
# ---------------------------------------------------------------------------

NODE_ENV=production
API_PORT=4000
LOG_LEVEL=info

# Native Postgres on the EC2 host (NOT inside the API image), port 5435.
DATABASE_URL=postgresql://surveylink:surveylink@host.docker.internal:5435/surveylink?schema=public
DIRECT_DATABASE_URL=postgresql://surveylink:surveylink@host.docker.internal:5435/surveylink?schema=public

WEB_APP_URL=https://staging.yourdomain.com
CORS_ORIGINS=https://staging.yourdomain.com

AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_ROLES_CLAIM=https://surveylink.app/roles
AUTH0_GOOGLE_CONNECTION=google-oauth2

AWS_REGION=us-east-2
S3_BUCKET=bld-build

SENTRY_DSN=
REDIS_URL=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=+10000000001
SUPER_ADMIN_NAME=Super Admin

AUTH_DEV_MODE=false
