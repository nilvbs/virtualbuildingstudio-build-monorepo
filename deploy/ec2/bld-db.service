# BLD staging — keep Postgres container running after reboot
[Unit]
Description=BLD staging Postgres (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bld
ExecStart=/usr/bin/docker compose -f docker-compose.staging.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.staging.yml stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
