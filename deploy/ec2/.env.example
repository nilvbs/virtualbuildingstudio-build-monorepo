# Copy to ~/BLD/stage/.env (chmod 600)
# Staging uses Aurora — pull URLs from AWS Secrets Manager (bld/api/*).
# Never commit real passwords.

NODE_ENV=production
API_PORT=4000
LOG_LEVEL=info

# Required (with TLS): from Secrets Manager bld/api/DATABASE_URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/surveylink?schema=public&sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/surveylink?schema=public&sslmode=require

WEB_APP_URL=https://staging.bld.online
CORS_ORIGINS=https://staging.bld.online

AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_ROLES_CLAIM=https://surveylink.app/roles
AUTH0_GOOGLE_CONNECTION=google-oauth2

AWS_REGION=us-east-2
S3_BUCKET=bld-build

SENTRY_DSN=

# Sessions: HMAC secret for API access tokens + OAuth state (falls back to AUTH0_CLIENT_SECRET).
# Generate: openssl rand -base64 48
SESSION_SIGNING_SECRET=
# Optional overrides (defaults: 900s access, 30 days refresh). Cookies are Secure when NODE_ENV=production.
ACCESS_TOKEN_TTL_SEC=
REFRESH_TOKEN_TTL_SEC=

# Shared rate limiting across API instances.
# Staging: deploy-api.yml generates REDIS_PASSWORD and sets REDIS_URL=redis://:<pw>@redis:6379
# (bld-redis sidecar, private compose network) only when REDIS_URL is empty.
# ElastiCache later: set REDIS_URL=rediss://… here; deploy leaves it untouched.
REDIS_PASSWORD=
REDIS_URL=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=+10000000001
SUPER_ADMIN_NAME=Super Admin

AUTH_DEV_MODE=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
TWILIO_EMAIL_FROM=
TWILIO_EMAIL_FROM_NAME=
