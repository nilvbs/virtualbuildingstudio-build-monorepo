# Copy to ~/BLD/stage/.env (chmod 600)

NODE_ENV=production
API_PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://surveylink:surveylink@db:5432/surveylink?schema=public
DIRECT_DATABASE_URL=postgresql://surveylink:surveylink@db:5432/surveylink?schema=public

# Same origin as the web app (Nginx serves both / and /api)
WEB_APP_URL=https://staging.bld.online
CORS_ORIGINS=https://staging.bld.online

AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_ROLES_CLAIM=https://surveylink.app/roles
AUTH0_GOOGLE_CONNECTION=google-oauth2

AWS_REGION=us-east-2
S3_BUCKET=bld-build

SENTRY_DSN=
REDIS_URL=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=+10000000001
SUPER_ADMIN_NAME=Super Admin

AUTH_DEV_MODE=false
